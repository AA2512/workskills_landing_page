 0px 0px -17px; box-shadow: rgba(0, 0, 0, 0.14) 0px 4px 12px 1px; height: a=
uto; overflow-y: unset; min-width: 120px; }

#b-scopeListItem-menu .b_sp_over_item { font-weight: normal; font-size: 13p=
x; color: rgb(68, 68, 68); text-align: left; padding: 0px 0px 0px 12px; mar=
gin: 0px; display: list-item; }

#b-scopeListItem-menu li.b_sp_over_item:hover { background: rgb(245, 245, 2=
45); color: rgb(17, 17, 17); border-bottom: 0px; }

#b-scopeListItem-menu .b_sp_over_item.divider { border-top: 1px solid rgb(2=
21, 221, 221); }

#b-scopeListItem-menu .b_sp_over_item a { display: inline-block; width: 100=
%; height: 100%; padding: 0px; line-height: 39px; text-transform: none; }

.b_sp_over_item .icon { background-repeat: no-repeat; background-size: 1350=
%; }

.b_sp_over_item .icon { display: inline-block; vertical-align: middle; marg=
in-right: 12px; height: 16px; width: 16px; }

.b_sp_over_item .text { display: inline-block; vertical-align: middle; }

.b_sp_over_menu #outlook .icon { background-position: -50px 0px; }

.b_sp_over_menu #excel .icon { background-position: 0px 0px; }

.b_sp_over_menu #word .icon { background-position: -117px 0px; }

.b_sp_over_menu #powerpoint .icon { background-position: -67px 0px; }

.b_sp_over_menu #onenote .icon { background-position: -33px 0px; }

.b_sp_over_menu #onedrive .icon { background-position: -16px 0px; }

.b_sp_over_menu #sway .icon { background-position: -167px 0px; }

.b_sp_over_menu #calendar .icon { background-position: -183px 0px; }

.b_sp_over_menu #people .icon { background-position: -200px 0px; }

.b_sp_over_item .icon { background-image: url("/rp/4HbL1kafp7kZCaGRQ_5yOMfA=
LrQ.png"); }

.b_scopebar #b-scopeListItem-menu { padding: 3px 0px; line-height: 30px; he=
ight: auto; }

.b_scopebar li:hover:not(.b_active)#b-scopeListItem-menu { border-bottom: 0=
px; }

.b_scopebar #b-scopeListItem-menu .b_sp_over_menu { margin: 5px 0px 0px 14p=
x; }

#b-scopeListItem-menu .b_sp_over_menu .b_scopebar_item a { font-size: 11px;=
 }

.b_scopebar #b-scopeListItem-menu svg { width: 16px; height: 16px; display:=
 block; }

.b_scopebar #b-scopeListItem-menu .b_sp_menu_separ { width: 16px; height: 1=
5px; display: inline-block; vertical-align: text-bottom; }

body:not(.b_sydConvMode) nav.b_scopebar li#b-scopeListItem-notebook { displ=
ay: none; }

.b_sydConvMode nav.b_scopebar li#b-scopeListItem-notebook { display: inline=
-block; visibility: visible; opacity: 1; }

.b_sydConvMode nav.b_scopebar li#b-scopeListItem-notebook svg { margin-righ=
t: 8px; transform: translateY(5px); fill: rgb(23, 74, 228); }

nav.b_scopebar li.b_active#b-scopeListItem-notebook::after { opacity: 0; }

.b_sydConvMode.b_notebookMode .b_sydShowConv nav.b_scopebar li#b-scopeListI=
tem-notebook::after { opacity: 1; }

.b_sydConvMode.b_notebookMode .b_sydShowConv nav.b_scopebar #b-scopeListIte=
m-conv::after { opacity: 0; }

.b_sydConvMode.b_notebookMode #b_bceBcbToggle .selected { pointer-events: a=
uto; }

body:not(.b_sydConvMode) .b_scopebar #b-scopeListItem-conv svg, body:not(.b=
_sydConvMode) .b_scopebar #b-scopeListItem-conv .scp_conv_mode { display: n=
one; }

#OverlayIFrame { border-radius: 15px; }

#OverlayIFrame { display: none; position: fixed; z-index: 1500; inset: 0px;=
 border: 0px; background-color: rgba(0, 0, 0, 0.8); height: 90%; width: 90%=
; margin: auto; }

#OverlayMask { top: 0px; position: fixed; z-index: 10; height: 100%; width:=
 100%; opacity: 0.6; background-color: rgb(0, 0, 0); }

body, #b_header { min-width: 1177px; }

#b_content { padding: 121px 0px 10px; overflow: visible; width: auto; }

#mm_header #b_header .b_logoArea { width: 68px; }

#b_header .b_scopebar { margin-right: 20px; }

.mm_sectionTitle { font-size: 20px; margin-bottom: 5px; line-height: normal=
; }

#mm_header #sb_form { margin-left: 18px; }

@media (max-width: 1160px) {
  .b_searchboxForm .b_searchbox { width: 454px; }
}
