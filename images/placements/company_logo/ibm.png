@charset "utf-8";

#id_hbfo { position: absolute; z-index: 1000; background-color: rgb(255, 25=
5, 255); text-align: left; width: 320px; line-height: normal; }

.nohpfo { top: 46px; right: -1px; }

.hpfo { top: 43px; right: 23px; }

#HBContent { padding: 12px 0px; }

.hb_section { display: block; position: relative; padding: 12px 20px; }

.hb_section:active, .hb_section:hover, .hb_section:visited { outline: 0px; =
background-color: rgb(245, 245, 245); }

.hb_section:focus { background-color: rgb(245, 245, 245); }

.hb_titlerow { color: rgb(68, 68, 68); display: block; font-size: 13px; hei=
ght: 17px; line-height: 17px; position: relative; }

.darkmode_toggle_row { display: flex; flex-direction: row; align-items: cen=
ter; }

.darkmode_toggle_icon { margin-right: 12px; flex-shrink: 0; }

#dtsetting_DarkSchemeSettings { flex: 1 1 0%; display: flex; flex-direction=
: row; align-items: center; font-size: 13px; color: rgb(68, 68, 68); }

.darkmode_toggle_label { flex: 1 1 0%; }

.darkmode_toggle_ctrl { flex-shrink: 0; }

.hbic_col, .hb_title_col, .hb_value_col { display: inline-block; font-size:=
 13px; height: 17px; color: rgb(68, 68, 68); user-select: none; }

.hbic_col { width: 20px; }

.hb_title_col { position: absolute; margin-left: 12px; max-width: 208px; }

.hb_value_col { position: absolute; margin-left: 20px; right: 0px; }

.hb_detrow { display: block; position: relative; font-size: 13px; height: 1=
7px; margin-left: 32px; width: 208px; margin-top: 8px; color: rgb(102, 102,=
 102); }

.hbic_setting, .hbic_history, .hbic_mybing, .hbic_feedback, .hbic_safesearc=
h, .hbic_homepage, .hbic_sign, .hbic_rewards, .hbic_chevdown, .hbic_chevup,=
 .hbic_privacy, .hbic_themes, .hbic_darkmode, .hbic_privatesearch, .hbic_he=
alth_privacy { background-repeat: no-repeat; position: absolute; background=
-size: 224px 16px; }

.hmb_sep { border-bottom: 1px solid rgb(204, 204, 204); }

.hbic_setting, .hbic_darkmode, .hbic_history, .hbic_mybing, .hbic_feedback,=
 .hbic_safesearch, .hbic_homepage, .hbic_sign, .hbic_rewards, .hbic_privacy=
, .hbic_themes, .hbic_saves, .hbic_privatesearch, .hbic_health_privacy { he=
ight: 16px; width: 16px; }

.hbic_setting { background-position: 0px 0px; }

.hbic_history { background-position: -18px 0px; }

.hbic_mybing { background-position: -36px 0px; }

.hbic_feedback { background-position: -54px 0px; }

.hbic_safesearch { background-position: -72px 0px; }

.hbic_homepage { background-position: -90px 0px; }

.hbic_sign { background-position: -108px 0px; }

.hbic_rewards { background-position: -126px 0px; }

.hbic_chevdown { background-position: -144px 0px; }

.hbic_chevup { background-position: -144px -9px; }

.hbic_privacy { background-position: -157px 0px; }

.hbic_health_privacy { background-position: -157px 0px; }

.hbic_themes { background-position: -174px 0px; }

.hbic_darkmode { background-position: -190px 0px; }

.hbic_privatesearch { background-position: -208px 0px; }

.hbic_chevdown, .hbic_chevup { right: 0px; height: 7px; width: 12px; top: 6=
px; }

.slide_down, .slide_up { overflow-y: hidden; transition: max-height 0.4s; }

.slide_up { max-height: 0px; border-width: 0px; }

.nohphbtop ~ .slide_down { max-height: unset; }

.nohphbtop ~ .slide_down.hb_setexp { max-height: unset; }

.hphbtop ~ .slide_down { max-height: unset; }

.hphbtop ~ .slide_down.hb_hpqexp { max-height: unset; }

